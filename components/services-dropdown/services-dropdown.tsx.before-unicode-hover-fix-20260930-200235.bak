                                )}
                              </span>
                              <span className="min-w-0 flex-1">
                                <span className="flex items-start gap-2">
                                  <span className="line-clamp-2 text-[12px] font-black leading-[1.28] text-kedi-navy transition-colors group-hover:text-[#0d478c] xl:text-[13.5px]">
