                                  {!service.mock && (
                                    <span className="ml-auto shrink-0 text-[14px] font-black text-kedi-navy/25 transition-all group-hover:translate-x-0.5 group-hover:text-[#b57e00]">
                                      â†—
                                    </span>
                                  )}
                                </span>
