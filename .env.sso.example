# Server-only SSO configuration; copy to local env or deployment secrets.
# Replace example hosts. Keep callback byte-for-byte identical in all three apps.
SSO_LADIPAGE_AUTHORIZE_URL=https://ladipage.example.com/api/auth/sso/authorize
SSO_KEDIPAGE_REDIRECT_URI=https://kedi.media/api/auth/sso/callback
SSO_BACKEND_API_URL=https://backend.example.com/api
# Same secret as Ladipage backend; at least 32 random characters. Never NEXT_PUBLIC_.
SSO_KEDIPAGE_CLIENT_SECRET=
